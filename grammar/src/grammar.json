{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "llvm_objdump",
  "rules": {
    "source": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_line"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              },
              {
                "type": "STRING",
                "value": "\n"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_line"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "file_header"
        },
        {
          "type": "SYMBOL",
          "name": "section_header"
        },
        {
          "type": "SYMBOL",
          "name": "symbol_label"
        },
        {
          "type": "SYMBOL",
          "name": "instruction_line"
        },
        {
          "type": "SYMBOL",
          "name": "relocation"
        },
        {
          "type": "SYMBOL",
          "name": "ellipsis"
        },
        {
          "type": "SYMBOL",
          "name": "comment"
        }
      ]
    },
    "file_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "path",
          "content": {
            "type": "SYMBOL",
            "name": "file_path"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "STRING",
          "value": "file format"
        },
        {
          "type": "FIELD",
          "name": "format",
          "content": {
            "type": "SYMBOL",
            "name": "file_format"
          }
        }
      ]
    },
    "file_path": {
      "type": "PATTERN",
      "value": "[^\\s:<]+"
    },
    "file_format": {
      "type": "PATTERN",
      "value": "\\S+"
    },
    "section_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "Disassembly of section"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "section_name"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        }
      ]
    },
    "section_name": {
      "type": "PATTERN",
      "value": "[^\\s:]+"
    },
    "symbol_label": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "address",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_label_address"
            },
            "named": true,
            "value": "address"
          }
        },
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "symbol"
          }
        },
        {
          "type": "STRING",
          "value": ">"
        },
        {
          "type": "STRING",
          "value": ":"
        }
      ]
    },
    "_label_address": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "[0-9a-fA-F]+"
          },
          {
            "type": "PATTERN",
            "value": "[ \\t]+"
          }
        ]
      }
    },
    "instruction_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "address",
          "content": {
            "type": "SYMBOL",
            "name": "address"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "bytes",
              "content": {
                "type": "SYMBOL",
                "name": "bytes"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "instruction"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "comment"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "address": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "[0-9a-fA-F]+"
          },
          {
            "type": "STRING",
            "value": ":"
          }
        ]
      }
    },
    "bytes": {
      "type": "PATTERN",
      "value": "[0-9a-fA-F]{2}([0-9a-fA-F]{2})*( [0-9a-fA-F]{2}([0-9a-fA-F]{2})*)*"
    },
    "instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "mnemonic",
          "content": {
            "type": "SYMBOL",
            "name": "mnemonic"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_operand"
          }
        }
      ]
    },
    "mnemonic": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][\\w.]*"
    },
    "_operand": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "register"
        },
        {
          "type": "SYMBOL",
          "name": "immediate"
        },
        {
          "type": "SYMBOL",
          "name": "symbol_ref"
        },
        {
          "type": "SYMBOL",
          "name": "operand_text"
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "STRING",
          "value": "}"
        },
        {
          "type": "STRING",
          "value": "!"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "STRING",
          "value": "*"
        },
        {
          "type": "STRING",
          "value": "+"
        },
        {
          "type": "STRING",
          "value": "-"
        }
      ]
    },
    "register": {
      "type": "PATTERN",
      "value": "%?[a-zA-Z_.][\\w.@]*"
    },
    "immediate": {
      "type": "PATTERN",
      "value": "[#$]?-?(0x[0-9a-fA-F]+|[0-9]+(\\.[0-9]+)?)"
    },
    "operand_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\s,\\[\\](){}<>!:*+\\-]+"
        }
      }
    },
    "symbol_ref": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "symbol"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "+"
                },
                {
                  "type": "FIELD",
                  "name": "offset",
                  "content": {
                    "type": "SYMBOL",
                    "name": "offset"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "symbol": {
      "type": "PATTERN",
      "value": "[^\\s<>+]+"
    },
    "offset": {
      "type": "PATTERN",
      "value": "0x[0-9a-fA-F]+"
    },
    "relocation": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "address",
          "content": {
            "type": "SYMBOL",
            "name": "address"
          }
        },
        {
          "type": "FIELD",
          "name": "type",
          "content": {
            "type": "SYMBOL",
            "name": "relocation_type"
          }
        },
        {
          "type": "FIELD",
          "name": "symbol",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[^\\s+\\-]+"
            },
            "named": true,
            "value": "symbol"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "STRING",
                      "value": "+"
                    },
                    {
                      "type": "STRING",
                      "value": "-"
                    }
                  ]
                },
                {
                  "type": "FIELD",
                  "name": "addend",
                  "content": {
                    "type": "SYMBOL",
                    "name": "offset"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "relocation_type": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "R_[A-Z0-9_]+"
        }
      }
    },
    "ellipsis": {
      "type": "STRING",
      "value": "..."
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "//"
              },
              {
                "type": "PATTERN",
                "value": "[^\\n]*"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ";"
              },
              {
                "type": "PATTERN",
                "value": "[^\\n]*"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "#"
              },
              {
                "type": "PATTERN",
                "value": "[ \\t]"
              },
              {
                "type": "PATTERN",
                "value": "[^\\n]*"
              }
            ]
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\r]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
